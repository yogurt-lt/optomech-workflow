,[-1.2640921982516065,29.2,-42.96642089508056]]]}]},"helices":{"07_IntegratedHousing":[{"name":"Male_HelicoidGroove_1","profile_zr_mm":[[-55.54,30.4],[-52.46,30.4],[-52.22,31.3],[-55.78,31.3]],"pitch_mm":6.0,"height_mm":44,"left_handed":true,"sw_active_center_z_mm":[-29.4,-11.1]}],"08_ShortFocusRing":[{"name":"Female_HelicoidGroove_1","profile_zr_mm":[[-52.586513257036636,30.2],[-49.413486742963364,30.2],[-49.66,31.12],[-52.34,31.12]],"pitch_mm":6.0,"height_mm":41.0,"left_handed":true,"sw_active_center_z_mm":[-37.4,-14.7]}]}}')


def focus_sketch(doc,body,name,points):
    pts=[App.Vector(*p) for p in points]
    origin=pts[0]
    u=pts[1]-origin;u.normalize()
    normal=None
    for p in pts[2:]:
        candidate=u.cross(p-origin)
        if candidate.Length>1e-7:normal=candidate;normal.normalize();break
    if normal is None:raise RuntimeError('Degenerate section '+name)
    v=normal.cross(u)
    local=[]
    for p in pts:
        delta=p-origin
        if abs(delta.dot(normal))>1e-6:raise RuntimeError('Nonplanar section '+name)
        local.append(App.Vector(delta.dot(u),delta.dot(v),0))
    sk=body.newObject('Sketcher::SketchObject',name)
    sk.Placement=App.Placement(origin,App.Rotation(u,v,normal,'ZXY'))
    sk.addGeometry([Part.LineSegment(local[i],local[(i+1)%len(local)]) for i in range(len(local))],False)
    sk.addConstraint([Sketcher.Constraint('Coincident',i,2,(i+1)%len(local),1) for i in range(len(local))])
    return sk

def focus_cut(doc,body,spec):
    previous=body.Tip;before=previous.Shape.Volume
    sketches=[focus_sketch(doc,body,spec['name']+'_Section_'+str(i+1),poly) for i,poly in enumerate(spec['sections'])]
    feat=body.newObject('PartDesign::SubtractiveLoft',spec['name'])
    feat.Profile=sketches[0];feat.Sections=sketches[1:]
    feat.Ruled=False;feat.Closed=False;feat.Refine=True
    body.Tip=feat;doc.recompute()
    if feat.Shape.isNull() or not feat.Shape.isValid() or len(feat.Shape.Solids)!=1 or before-feat.Shape.Volume<1e-6:
        raise RuntimeError('Invalid cut '+spec['name']+' / '+str(feat.State))
    if App.GuiUp:
        previous.Visibility=False
        for sk in sketches:sk.Visibility=False
    return dict(name=spec['name'],removed_volume_mm3=before-feat.Shape.Volume,sections=len(sketches))


def build_helicoid(doc,body,spec):
    previous=body.Tip;before=previous.Shape.Volume
    poly=spec['profile_zr_mm'];zc=(poly[0][0]+poly[1][0])/2
    lo,hi=spec['sw_active_center_z_mm'];phase=-360*(lo-zc)/spec['pitch_mm']
    sk=body.newObject('Sketcher::SketchObject',spec['name']+'_Profile')
    sk.Placement=App.Placement(App.Vector(),App.Rotation(App.Vector(0,0,1),phase).multiply(App.Rotation(App.Vector(1,0,0),90)))
    pts=[App.Vector(r,z-zc+lo,0) for z,r in poly]
    sk.addGeometry([Part.LineSegment(pts[i],pts[(i+1)%len(pts)]) for i in range(len(pts))],False)
    sk.addConstraint([Sketcher.Constraint('Coincident',i,2,(i+1)%len(pts),1) for i in range(len(pts))])
    feat=body.newObject('PartDesign::SubtractiveHelix',spec['name'])
    feat.Profile=sk;feat.ReferenceAxis=(sk,['V_Axis']);feat.Mode=0
    feat.Pitch=spec['pitch_mm'];feat.Height=hi-lo;feat.LeftHanded=True;feat.Reversed=False;feat.Refine=True
    body.Tip=feat;doc.recompute()
    if feat.Shape.isNull() or not feat.Shape.isValid() or len(feat.Shape.Solids)!=1 or before-feat.Shape.Volume<1e-6:raise RuntimeError('Helicoid failed '+spec['name']+' '+str(feat.State)+' valid='+str(feat.Shape.isValid())+' solids='+str(len(feat.Shape.Solids))+' volume='+str(feat.Shape.Volume)+' removed='+str(before-feat.Shape.Volume))
    if App.GuiUp:previous.Visibility=False;sk.Visibility=False
    return dict(name=spec['name'],removed_volume_mm3=before-feat.Shape.Volume,phase_deg=phase)

def dg_main():
    destination=choose_directory()
    if destination is None:return
    stamp=datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f');run=destination/('DG50_'+stamp);run.mkdir()
    doc=App.newDocument('DG50_'+stamp);doc.Label='Double Gauss 50 F1.8 / manual helicoid'
    root=doc.addObject('App::Part','FocusAssembly')
    control=doc.addObject('App::FeaturePython','FocusControl');root.addObject(control)
    control.addProperty('App::PropertyFloatConstraint','AngleDeg','Focus');control.AngleDeg=(0.,0.,270.,1.)
    control.addProperty('App::PropertyLength','Travel','Focus');control.setExpression('Travel','-AngleDeg * 6 mm / 360')
    control.addProperty('App::PropertyString','Note','Focus');control.Note='Reference angle is not optically calibrated infinity. EF mount is an envelope; mirror clearance unverified.'
    groups={}
    for key,name in [('moving','MovingOptics'),('ring','RotatingRing'),('fixed','FixedFrame')]:
        group=doc.addObject('App::Part',name);root.addObject(group);groups[key]=group
    for key in ('moving','ring'):groups[key].setExpression('Placement.Base.z','FocusControl.Travel')
    groups['ring'].Placement=App.Placement(App.Vector(),App.Rotation(App.Vector(0,0,1),0))
    groups['ring'].setExpression('Placement.Rotation.Angle','FocusControl.AngleDeg * 1 deg')
    log=dict(status='building',parts=[],cuts=[],helices=[],motion='dz=-6*theta/360; ring rotates and translates, optical cartridge translates only')
    try:
        for item in PLAN['parts']+FOCUS_DATA['accessories']:
            item=dict(item);item.setdefault('is_glass',False);item.setdefault('cuts',[])
            name=item['name'];group=groups[item.get('group','moving')]
            print('Building '+name,flush=True)
            result=build_part(doc,group,item,0.)
            body=next(b for b in group.Group if b.Label==name)
            for spec in FOCUS_DATA['cuts'].get(name,[]):log['cuts'].append(focus_cut(doc,body,spec))
            for spec in FOCUS_DATA['helices'].get(name,[]):log['helices'].append(build_helicoid(doc,body,spec))
            placement=item.get('placement',{})
            if 'radial_angle_deg' in placement:
                a=math.radians(placement['radial_angle_deg']);n=App.Vector(math.cos(a),math.sin(a),0)
                body.Placement=App.Placement(App.Vector(0,0,placement['z_mm']),App.Rotation(App.Vector(-math.sin(a),math.cos(a),0),App.Vector(0,0,1),n,'ZXY'))
            elif placement:body.Placement=App.Placement(App.Vector(placement.get('x_mm',0),placement.get('y_mm',0),0),App.Rotation())
            if App.GuiUp:
                color=tuple(item['color_rgb'])
                for obj in (body,body.Tip):
                    obj.ViewObject.ShapeColor=color;obj.ViewObject.DiffuseColor=[color]*len(body.Tip.Shape.Faces);obj.ViewObject.Transparency=55 if item.get('is_glass') else 0;obj.Visibility=True
                for obj in body.Group:
                    if obj!=body.Tip:obj.Visibility=False
            result['final_volume_mm3']=body.Shape.Volume;log['parts'].append(result)
        doc.recompute()
        if App.GuiUp:
            items={x['name']:x for x in PLAN['parts']+FOCUS_DATA['accessories']}
            for group in groups.values():
                group.Visibility=True
                for body in group.Group:
                    if body.TypeId=='PartDesign::Body':apply_body_appearance(body,items[body.Label])
        path=run/'DoubleGauss50_Manual_v02.FCStd';doc.saveAs(str(path))
        log.update(status='success',document=str(path));(run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8')
        if App.GuiUp:
            import FreeCADGui as Gui
            view=Gui.getDocument(doc.Name)
            if view:
                view.activeView().viewAxonometric();view.activeView().fitAll()
                from PySide import QtWidgets
                QtWidgets.QApplication.processEvents()
                doc.save()
        App.Console.PrintMessage('Saved '+str(path)+'\nChange FocusControl.AngleDeg (0..270) to focus.\n')
    except Exception:
        log.update(status='failed',error=traceback.format_exc());(run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8');raise

dg_main()

