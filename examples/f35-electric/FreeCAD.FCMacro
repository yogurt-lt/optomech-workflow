def focus_sketch(doc,body,name,points):
    pts=[App.Vector(*p) for p in points]
    origin=pts[0]
    u=pts[1]-origin;u.normalize()
    normal=None
    for p in pts[2:]:
        candidate=u.cross(p-origin)
        if candidate.Length>1e-7:normal=candidate;normal.normalize();break
    if normal is None:raise RuntimeError('Degenerate section '+name)
    v=normal.cross(u)
    local=[]
    for p in pts:
        delta=p-origin
        if abs(delta.dot(normal))>1e-6:raise RuntimeError('Nonplanar section '+name)
        local.append(App.Vector(delta.dot(u),delta.dot(v),0))
    sk=body.newObject('Sketcher::SketchObject',name)
    sk.Placement=App.Placement(origin,App.Rotation(u,v,normal,'ZXY'))
    sk.addGeometry([Part.LineSegment(local[i],local[(i+1)%len(local)]) for i in range(len(local))],False)
    sk.addConstraint([Sketcher.Constraint('Coincident',i,2,(i+1)%len(local),1) for i in range(len(local))])
    return sk

def focus_cut(doc,body,spec):
    previous=body.Tip;before=previous.Shape.Volume
    sketches=[focus_sketch(doc,body,spec['name']+'_Section_'+str(i+1),poly) for i,poly in enumerate(spec['sections'])]
    feat=body.newObject('PartDesign::SubtractiveLoft',spec['name'])
    feat.Profile=sketches[0];feat.Sections=sketches[1:]
    feat.Ruled=False;feat.Closed=False;feat.Refine=True
    body.Tip=feat;doc.recompute()
    if feat.Shape.isNull() or not feat.Shape.isValid() or len(feat.Shape.Solids)!=1 or before-feat.Shape.Volume<1e-6:
        raise RuntimeError('Invalid cut '+spec['name']+' / '+str(feat.State))
    if App.GuiUp:
        previous.Visibility=False
        for sk in sketches:sk.Visibility=False
    return dict(name=spec['name'],removed_volume_mm3=before-feat.Shape.Volume,sections=len(sketches))


def cut_gear(doc,body,spec):
    before=body.Tip.Shape.Volume
    sk=body.newObject('Sketcher::SketchObject','InvoluteToothSpaces')
    sk.Placement=App.Placement(App.Vector(0,0,spec['z_max']),App.Rotation())
    lines=[]
    for poly in spec['polygons_xy_mm']:
        pts=[App.Vector(x,y,0) for x,y in poly]
        lines.extend(Part.LineSegment(pts[i],pts[(i+1)%len(pts)]) for i in range(len(pts)))
    sk.addGeometry(lines,False)
    checked_pocket(doc,body,sk,'InvoluteGearTeeth',spec['z_max']-spec['z_min']);feat=body.Tip
    if feat.Shape.isNull() or not feat.Shape.isValid() or len(feat.Shape.Solids)!=1 or before-feat.Shape.Volume<.1:raise RuntimeError('Invalid gear '+body.Label)
    return dict(name=body.Label,teeth=spec['teeth'],removed_mm3=before-feat.Shape.Volume)

def f35_main():
    destination=choose_directory()
    if destination is None:return
    stamp=datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f');run=destination/('F35_'+stamp);run.mkdir()
    doc=App.newDocument('F35_'+stamp);doc.Label='F35 F2.8 / L2 electric internal focus'
    root=doc.addObject('App::Part','FocusAssembly')
    control=doc.addObject('App::FeaturePython','FocusControl');root.addObject(control)
    control.addProperty('App::PropertyFloatConstraint','AngleDeg','Focus');control.AngleDeg=(0.,-40.,40.,1.)
    control.addProperty('App::PropertyFloat','U','Focus');control.setExpression('U','(AngleDeg + 40) / 80')
    control.addProperty('App::PropertyLength','Travel','Focus');control.setExpression('Travel','(-2 + 4 * (3 * U * U - 2 * U * U * U)) * 1 mm')
    control.addProperty('App::PropertyString','Note','Focus');control.Note='Only L2 moves; demo +/-2mm, not an optical working-distance calibration. Motor, supports and camera interface excluded.'
    groups={}
    for key,name in [('fixed','FixedFrame'),('moving','MovingL2'),('cam','RotatingCam'),('pinion','InputPinion')]:
        group=doc.addObject('App::Part',name);root.addObject(group);groups[key]=group
    groups['moving'].setExpression('Placement.Base.z','FocusControl.Travel')
    for key,multiplier in [('cam',1),('pinion',-5)]:
        groups[key].Placement=App.Placement(App.Vector(38.4 if key=='pinion' else 0,0,0),App.Rotation(App.Vector(0,0,1),0))
        groups[key].setExpression('Placement.Rotation.Angle',str(multiplier)+' * FocusControl.AngleDeg * 1 deg')
    log=dict(status='building',parts=[],cuts=[],gears=[],motion='L2 dz=-2+4*(3u^2-2u^3); u=(theta+40)/80; cam rotates theta; input pinion rotates -5theta')
    try:
        items=PLAN['parts']+FOCUS_DATA['accessories']
        for item in items:
            item=dict(item);item.setdefault('is_glass',False);item.setdefault('cuts',[])
            group=groups[item.get('group','fixed')];name=item['name'];print('Building '+name,flush=True)
            result=build_part(doc,group,item,0.)
            body=next(b for b in group.Group if b.Label==name)
            for spec in FOCUS_DATA['cuts'].get(name,[]):log['cuts'].append(focus_cut(doc,body,spec))
            if name in FOCUS_DATA['gears']:log['gears'].append(cut_gear(doc,body,FOCUS_DATA['gears'][name]))
            placement=item.get('placement',{})
            if 'radial_angle_deg' in placement:
                a=math.radians(placement['radial_angle_deg']);n=App.Vector(math.cos(a),math.sin(a),0)
                body.Placement=App.Placement(App.Vector(0,0,placement['z_mm']),App.Rotation(App.Vector(-math.sin(a),math.cos(a),0),App.Vector(0,0,1),n,'ZXY'))
            elif placement and item.get('group')!='pinion':body.Placement=App.Placement(App.Vector(placement.get('x_mm',0),placement.get('y_mm',0),0),App.Rotation())
            result['final_volume_mm3']=body.Shape.Volume;log['parts'].append(result)
        doc.recompute()
        if App.GuiUp:
            for group in groups.values():group.Visibility=True
            mapping={p['name']:p for p in items}
            for body in [b for b in doc.Objects if b.TypeId=='PartDesign::Body']:apply_body_appearance(body,mapping[body.Label])
            import FreeCADGui as Gui
            view=Gui.getDocument(doc.Name).activeView();view.viewAxonometric();view.fitAll()
        path=run/'F35_Electric_v02.FCStd';doc.recompute();doc.saveAs(str(path))
        log.update(status='success',document=str(path));(run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8')
        print('Saved '+str(path),flush=True)
    except Exception:
        log.update(status='failed',error=traceback.format_exc());(run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8');raise

f35_main()
