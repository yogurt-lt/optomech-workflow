def focus_sketch(doc,body,name,points):
    pts=[App.Vector(*p) for p in points]
    origin=pts[0]
    u=pts[1]-origin;u.normalize()
    normal=None
    for p in pts[2:]:
        candidate=u.cross(p-origin)
        if candidate.Length>1e-7:normal=candidate;normal.normalize();break
    if normal is None:raise RuntimeError('Degenerate section '+name)
    v=normal.cross(u)
    local=[]
    for p in pts:
        delta=p-origin
        if abs(delta.dot(normal))>1e-6:raise RuntimeError('Nonplanar section '+name)
        local.append(App.Vector(delta.dot(u),delta.dot(v),0))
    sk=body.newObject('Sketcher::SketchObject',name)
    sk.Placement=App.Placement(origin,App.Rotation(u,v,normal,'ZXY'))
    sk.addGeometry([Part.LineSegment(local[i],local[(i+1)%len(local)]) for i in range(len(local))],False)
    sk.addConstraint([Sketcher.Constraint('Coincident',i,2,(i+1)%len(local),1) for i in range(len(local))])
    return sk

def focus_cut(doc,body,spec):
    previous=body.Tip;before=previous.Shape.Volume
    sketches=[focus_sketch(doc,body,spec['name']+'_Section_'+str(i+1),poly) for i,poly in enumerate(spec['sections'])]
    feat=body.newObject('PartDesign::SubtractiveLoft',spec['name'])
    feat.Profile=sketches[0];feat.Sections=sketches[1:]
    feat.Ruled=False;feat.Closed=False;feat.Refine=True
    body.Tip=feat;doc.recompute()
    if feat.Shape.isNull() or not feat.Shape.isValid() or len(feat.Shape.Solids)!=1 or before-feat.Shape.Volume<1e-6:
        raise RuntimeError('Invalid cut '+spec['name']+' / '+str(feat.State))
    if App.GuiUp:
        previous.Visibility=False
        for sk in sketches:sk.Visibility=False
    return dict(name=spec['name'],removed_volume_mm3=before-feat.Shape.Volume,sections=len(sketches))


def cut_gear(doc,body,spec):
    before=body.Tip.Shape.Volume
    sk=body.newObject('Sketcher::SketchObject','InvoluteToothSpaces')
    sk.Placement=App.Placement(App.Vector(0,0,spec['z_max']),App.Rotation())
    lines=[]
    for poly in spec['polygons_xy_mm']:
        pts=[App.Vector(x,y,0) for x,y in poly]
        lines.extend(Part.LineSegment(pts[i],pts[(i+1)%len(pts)]) for i in range(len(pts)))
    sk.addGeometry(lines,False)
    checked_pocket(doc,body,sk,'InvoluteGearTeeth',spec['z_max']-spec['z_min']);feat=body.Tip
    if feat.Shape.isNull() or not feat.Shape.isValid() or len(feat.Shape.Solids)!=1 or before-feat.Shape.Volume<.1:raise RuntimeError('Invalid gear '+body.Label)
    return dict(name=body.Label,teeth=spec['teeth'],removed_mm3=before-feat.Shape.Volume)


def projection_main():
    folder=choose_directory()
    if folder is None:return
    run=folder/('Projection_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S'));run.mkdir()
    doc=App.newDocument('CompactProjection');doc.Label='30-39mm compact projection / editable prototype'
    root=doc.addObject('App::Part','ProjectionAssembly')
    control=doc.addObject('App::FeaturePython','MotionControl');root.addObject(control)
    control.addProperty('App::PropertyFloatConstraint','ZoomDeg','Motion');control.ZoomDeg=(0.,0.,90.,1.)
    control.addProperty('App::PropertyFloatConstraint','FocusDeg','Motion');control.FocusDeg=(0.,-45.,45.,1.)
    control.addProperty('App::PropertyLength','FocusTravel','Motion');control.setExpression('FocusTravel','FocusDeg / 75 * 1 mm')
    control.addProperty('App::PropertyString','Scope','Motion');control.Scope='Three optical zoom nodes; nominal fits and threads; revised peripheral rims. Mechanical interpolation, not optical certification.'
    unit=doc.addObject('App::Part','FocusingUnit');root.addObject(unit);unit.setExpression('Placement.Base.z','MotionControl.FocusTravel')
    groups={}
    for key in ['fixed','guide','a','b','c','cam','focus','zp','fp']:
        g=doc.addObject('App::Part','Group_'+key);(unit if key in ['guide','a','b','c','cam'] else root).addObject(g);groups[key]=g
        if key in ['a','b','c']:
            prop='Travel_'+key;control.addProperty('App::PropertyLength',prop,'Motion');control.setExpression(prop,EXTRA['motion']['expressions'][key]);g.setExpression('Placement.Base.z','MotionControl.'+prop)
        if key in ['cam','focus','zp','fp']:
            g.Placement=App.Placement(App.Vector(36 if key in ['zp','fp'] else 0,0,0),App.Rotation(App.Vector(0,0,1),0))
            g.setExpression('Placement.Rotation.Angle',('MotionControl.ZoomDeg' if key in ['cam','zp'] else 'MotionControl.FocusDeg')+(' * -8 deg' if key in ['zp','fp'] else ' * 1 deg'))
    log=dict(status='building',parts=[],cuts=[],gears=[])
    try:
        for item in PLAN['parts']:
            name=item['name'];g=groups[item['group']];print('Building '+name,flush=True)
            result=build_part(doc,g,item,0);body=next(b for b in g.Group if b.Label==name)
            for cut in EXTRA['cuts'].get(name,[]):
                print('  Cut '+cut['name'],flush=True);log['cuts'].append(focus_cut(doc,body,cut))
            if name in EXTRA['gears']:log['gears'].append(cut_gear(doc,body,EXTRA['gears'][name]))
            placement=item.get('placement',{})
            if 'radial_angle_deg' in placement:
                a=math.radians(placement['radial_angle_deg']);body.Placement=App.Placement(App.Vector(0,0,placement['z_mm']),App.Rotation(App.Vector(-math.sin(a),math.cos(a),0),App.Vector(0,0,1),App.Vector(math.cos(a),math.sin(a),0),'ZXY'))
            # Pinion center belongs to its coordinate group.
            result['final_volume_mm3']=body.Tip.Shape.Volume;log['parts'].append(result)
            (run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8')
        doc.recompute()
        if App.GuiUp:
            for b in [b for b in doc.Objects if b.TypeId=='PartDesign::Body']:apply_body_appearance(b,next(p for p in PLAN['parts'] if p['name']==b.Label))
            import FreeCADGui as Gui
            Gui.activeDocument().activeView().viewAxonometric();Gui.activeDocument().activeView().fitAll()
        path=run/'Projection_Zoom_v05.FCStd';doc.recompute();doc.saveAs(str(path));log.update(status='success',document=str(path))
        (run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8');print('Saved '+str(path),flush=True)
    except Exception:
        log.update(status='failed',error=traceback.format_exc());(run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8');raise

projection_main()
