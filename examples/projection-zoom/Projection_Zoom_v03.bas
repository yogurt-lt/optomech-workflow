Private Function ProjectionTravel(ByVal zoomDeg As Double, ByVal groupID As String) As Double
    Dim t As Double
    Select Case groupID
    Case "a"
        If zoomDeg <= 45 Then
            t = zoomDeg - 0
            ProjectionTravel = (0.000000000000000) + (0.153507427147354) * t ^ 1 + (-0.000329857173121) * t ^ 2 + (-0.000001258004387) * t ^ 3
        ElseIf zoomDeg <= 90 Then
            t = zoomDeg - 45
            ProjectionTravel = (6.125237796316981) + (0.116177904916867) * t ^ 1 + (-0.000273246975717) * t ^ 2 + (-0.000001258004387) * t ^ 3
        End If
    Case "b"
        If zoomDeg <= 45 Then
            t = zoomDeg - 0
            ProjectionTravel = (0.000000000000000) + (-0.068446980793423) * t ^ 1 + (-0.000105791846436) * t ^ 2 + (0.000000129079859) * t ^ 3
        ElseIf zoomDeg <= 90 Then
            t = zoomDeg - 45
            ProjectionTravel = (-3.282580222553023) + (-0.077184086827048) * t ^ 1 + (-0.000111600440108) * t ^ 2 + (0.000000129079859) * t ^ 3
        End If
    Case "c"
        If zoomDeg <= 45 Then
            t = zoomDeg - 0
            ProjectionTravel = (0.000000000000000) + (0.012794170388332) * t ^ 1 + (-0.000284314897518) * t ^ 2 + (0.000002106036278) * t ^ 3
        ElseIf zoomDeg <= 90 Then
            t = zoomDeg - 45
            ProjectionTravel = (0.191912555824985) + (0.000000000000000) * t ^ 1 + (-0.000486365072789) * t ^ 2 + (0.000002900692150) * t ^ 3
        End If
    End Select
End Function

Private Function FocusSection(ByVal model As SldWorks.ModelDoc2, ByVal vertices As Variant, ByVal sectionName As String) As SldWorks.Feature
    Dim feat As SldWorks.Feature, found As SldWorks.Feature, seg As SldWorks.SketchSegment
    Dim p As Variant, q As Variant, i As Long, j As Long, count As Long
    model.ClearSelection2 True
    model.SketchManager.Insert3DSketch True
    model.SketchManager.AddToDB = True
    For i = LBound(vertices) To UBound(vertices)
        j = i + 1: If j > UBound(vertices) Then j = LBound(vertices)
        p = vertices(i): q = vertices(j)
        Set seg = model.SketchManager.CreateLine(CDbl(p(0)) / 1000#, CDbl(p(1)) / 1000#, CDbl(p(2)) / 1000#, CDbl(q(0)) / 1000#, CDbl(q(1)) / 1000#, CDbl(q(2)) / 1000#)
        If seg Is Nothing Then Err.Raise vbObjectError + 801, , "Focus section line failed: " & sectionName
    Next i
    model.SketchManager.AddToDB = False
    model.SketchManager.Insert3DSketch True
    Set feat = model.FirstFeature
    Do While Not feat Is Nothing
        If feat.GetTypeName2 = "3DProfileFeature" Then
            If Left$(feat.Name, 3) <> "FS_" Then
                Set found = feat: count = count + 1
            End If
        End If
        Set feat = feat.GetNextFeature
    Loop
    If count <> 1 Then Err.Raise vbObjectError + 802, , "Expected one new focus section: " & sectionName
    found.Name = "FS_" & sectionName
    model.ClearSelection2 True
    Set FocusSection = found
End Function

Private Sub FocusLoftCut(ByVal model As SldWorks.ModelDoc2, ByVal cutName As String, ByVal sectionIDs As Variant)
    Dim sections() As SldWorks.Feature, section As SldWorks.Feature, cutFeat As SldWorks.Feature
    Dim vertices As Variant, i As Long
    currentStage = "Focus cut " & cutName
    ReDim sections(UBound(sectionIDs))
    For i = 0 To UBound(sectionIDs)
        vertices = FocusSectionData(CLng(sectionIDs(i)))
        Set sections(i) = FocusSection(model, vertices, cutName & "_" & CStr(i))
    Next i
    model.ClearSelection2 True
    For i = 0 To UBound(sections)
        Set section = sections(i)
        If section.Select2(True, 1) = False Then Err.Raise vbObjectError + 803, , "Focus loft profile selection failed: " & cutName
    Next i
    Set cutFeat = model.FeatureManager.InsertCutBlend(False, False, False, 1#, 0, 0, False, 0#, 0#, 0, False, True)
    If cutFeat Is Nothing Then
        buildLog.WriteLine "FAILED cut " & cutName & "; first profile=" & CStr(sectionIDs(0)) & "; last profile=" & CStr(sectionIDs(UBound(sectionIDs)))
        Err.Raise vbObjectError + 804, , "Adjacent-section cut failed: " & cutName
    End If
    cutFeat.Name = cutName
    model.ClearSelection2 True
    model.EditRebuild3
    buildLog.WriteLine "Created focus loft cut: " & cutName
    If checkingCurvedPart Then CheckCamSolid model, cutName
End Sub

Private Sub ProjectionSetPose(ByVal angleDeg As Double, ByVal focusDeg As Double)
    On Error GoTo FocusFailed
    Dim model As SldWorks.ModelDoc2, assembly As SldWorks.AssemblyDoc
    Dim component As SldWorks.Component2, components As Variant, matrix As Variant
    Dim math As SldWorks.MathUtility, move As SldWorks.MathTransform, i As Long
    If angleDeg < 0# Or angleDeg > 90# Or Abs(focusDeg) > 45# Then Err.Raise vbObjectError + 805, , "Zoom0..90 degrees; focus -45..45 degrees."
    Set app = Application.SldWorks
    Set model = app.ActiveDoc
    If model Is Nothing Then Err.Raise vbObjectError + 806, , "Open the focus assembly."
    If model.GetType <> 2 Then Err.Raise vbObjectError + 807, , "Activate the generated focus assembly."
    Set assembly = model: Set math = app.GetMathUtility
    components = assembly.GetComponents(False)
    For i = 0 To UBound(components)
        Set component = components(i)
        If FocusKnownComponent(component.Name2) Then
            model.ClearSelection2 True
            If component.Select4(False, Nothing, False) = False Then Err.Raise vbObjectError + 808, , "Cannot select focus component."
            assembly.UnfixComponent
            matrix = ProjectionPlacement(component.Name2, angleDeg, focusDeg)
            Set move = math.CreateTransform(matrix)
            component.Transform2 = move
            assembly.FixComponent
        End If
    Next i
    model.ClearSelection2 True: model.EditRebuild3: model.ViewZoomtofit2
    MsgBox "Focus angle=" & CStr(angleDeg) & " deg; whole optical shift=" & CStr(focusDeg / 75#) & " mm." & vbCrLf & "Coordinate demonstration; no cam mates added.", vbInformation
    Exit Sub
FocusFailed:
    MsgBox "Focus pose stopped: " & Err.Description, vbExclamation
End Sub

Private Function FocusKnownComponent(ByVal label As String) As Boolean
    FocusKnownComponent = (InStr(label, "OM_") > 0)
End Function

Public Sub ZoomWide()
    ProjectionSetPose 0#, 0#
End Sub
Public Sub ZoomMiddle()
    ProjectionSetPose 45#, 0#
End Sub
Public Sub ZoomTele()
    ProjectionSetPose 90#, 0#
End Sub
Public Sub FocusNearAtMiddleZoom()
    ProjectionSetPose 45#, -33.39048
End Sub
Public Sub FocusFarAtMiddleZoom()
    ProjectionSetPose 45#, 13.39185
End Sub

Private Sub CheckCamSolid(ByVal model As SldWorks.ModelDoc2, ByVal cutName As String)
    Dim partDoc As SldWorks.PartDoc, bodies As Variant, bodyCount As Long
    Dim diagnosticPath As String, saveStatus As Long
    Set partDoc = model
    bodies = partDoc.GetBodies2(0, False)
    If IsArray(bodies) Then bodyCount = UBound(bodies) - LBound(bodies) + 1
    buildLog.WriteLine "Solid count after " & cutName & ": " & CStr(bodyCount)
    If bodyCount <> 1 Then
        diagnosticPath = diagnosticFolder & "\Cam_Diagnostic.SLDPRT"
        saveStatus = model.SaveAs3(diagnosticPath, 0, SAVE_SILENT)
        Err.Raise vbObjectError + 814, , "Cam solid count=" & CStr(bodyCount) & " after " & cutName & "; diagnostic save=" & CStr(saveStatus)
    End If
End Sub
