def focus_sketch(doc,body,name,points):
    pts=[App.Vector(*p) for p in points]
    origin=pts[0]
    u=pts[1]-origin;u.normalize()
    normal=None
    for p in pts[2:]:
        candidate=u.cross(p-origin)
        if candidate.Length>1e-7:normal=candidate;normal.normalize();break
    if normal is None:raise RuntimeError('Degenerate section '+name)
    v=normal.cross(u)
    local=[]
    for p in pts:
        delta=p-origin
        if abs(delta.dot(normal))>1e-6:raise RuntimeError('Nonplanar section '+name)
        local.append(App.Vector(delta.dot(u),delta.dot(v),0))
    sk=body.newObject('Sketcher::SketchObject',name)
    sk.Placement=App.Placement(origin,App.Rotation(u,v,normal,'ZXY'))
    sk.addGeometry([Part.LineSegment(local[i],local[(i+1)%len(local)]) for i in range(len(local))],False)
    sk.addConstraint([Sketcher.Constraint('Coincident',i,2,(i+1)%len(local),1) for i in range(len(local))])
    return sk

def focus_cut(doc,body,spec):
    previous=body.Tip;before=previous.Shape.Volume
    sketches=[focus_sketch(doc,body,spec['name']+'_Section_'+str(i+1),poly) for i,poly in enumerate(spec['sections'])]
    feat=body.newObject('PartDesign::SubtractiveLoft',spec['name'])
    feat.Profile=sketches[0];feat.Sections=sketches[1:]
    feat.Ruled=True;feat.Closed=False;feat.Refine=True
    body.Tip=feat;doc.recompute()
    if feat.Shape.isNull() or not feat.Shape.isValid() or len(feat.Shape.Solids)!=1 or before-feat.Shape.Volume<1e-6:
        raise RuntimeError('Invalid cut '+spec['name']+' / '+str(feat.State))
    if App.GuiUp:
        previous.Visibility=False
        for sk in sketches:sk.Visibility=False
    return dict(name=spec['name'],removed_volume_mm3=before-feat.Shape.Volume,sections=len(sketches))


def cut_gear(doc,body,spec):
    before=body.Tip.Shape.Volume
    sk=body.newObject('Sketcher::SketchObject','InvoluteToothSpaces')
    sk.Placement=App.Placement(App.Vector(0,0,spec['z_max']),App.Rotation())
    lines=[]
    for poly in spec['polygons_xy_mm']:
        pts=[App.Vector(x,y,0) for x,y in poly]
        lines.extend(Part.LineSegment(pts[i],pts[(i+1)%len(pts)]) for i in range(len(pts)))
    sk.addGeometry(lines,False)
    checked_pocket(doc,body,sk,'InvoluteGearTeeth',spec['z_max']-spec['z_min']);feat=body.Tip
    if feat.Shape.isNull() or not feat.Shape.isValid() or len(feat.Shape.Solids)!=1 or before-feat.Shape.Volume<.1:raise RuntimeError('Invalid gear '+body.Label)
    return dict(name=body.Label,teeth=spec['teeth'],removed_mm3=before-feat.Shape.Volume)


def zoom_main():
    destination=choose_directory()
    if destination is None:return
    stamp=datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    run=destination/('Zoom_'+stamp);run.mkdir()
    doc=App.newDocument('Zoom_'+stamp);doc.Label='Zoom / two-group cam / editable v0.2'
    root=doc.addObject('App::Part','ZoomAssembly')
    control=doc.addObject('App::FeaturePython','ZoomControl');root.addObject(control)
    control.addProperty('App::PropertyFloatConstraint','AngleDeg','Zoom');control.AngleDeg=(0.,0.,330.,1.)
    control.addProperty('App::PropertyLength','G2Travel','Zoom')
    control.addProperty('App::PropertyLength','G3Travel','Zoom')
    control.setExpression('G2Travel',ZOOM_DATA['motion']['freecad_g2_expression'])
    control.setExpression('G3Travel',ZOOM_DATA['motion']['freecad_g3_expression'])
    control.addProperty('App::PropertyString','Scope','Zoom');control.Scope='Five original source nodes. Interpolation is mechanical, not optical certification; nominal threads and fits. Rear G4 uses configuration1 datum explicitly.'
    groups={}
    for key,label in [('fixed','FixedFrame'),('g2','MovingG2'),('g3','MovingG3'),('cam','RotatingCam'),('pinion','InputPinion')]:
        g=doc.addObject('App::Part',label);root.addObject(g);groups[key]=g
    groups['g2'].setExpression('Placement.Base.z','ZoomControl.G2Travel')
    groups['g3'].setExpression('Placement.Base.z','ZoomControl.G3Travel')
    for key,ratio in [('cam',1.),('pinion',-6.4)]:
        groups[key].Placement=App.Placement(App.Vector(92.5 if key=='pinion' else 0,0,0),App.Rotation(App.Vector(0,0,1),0))
        groups[key].setExpression('Placement.Rotation.Angle',str(ratio)+' * ZoomControl.AngleDeg * 1 deg')
    log=dict(status='building',parts=[],cuts=[],gears=[],scope=control.Scope)
    try:
        for item in PLAN['parts']:
            name=item['name'];group=groups[item.get('group','fixed')]
            print('Building '+name,flush=True)
            result=build_part(doc,group,item,0.)
            b=next(b for b in group.Group if b.Label==name)
            for spec in ZOOM_DATA['cuts'].get(name,[]):
                print('  Cut '+spec['name'],flush=True);log['cuts'].append(focus_cut(doc,b,spec))
            if name in ZOOM_DATA['gears']:log['gears'].append(cut_gear(doc,b,ZOOM_DATA['gears'][name]))
            placement=item.get('placement',{})
            if 'radial_angle_deg' in placement:
                a=math.radians(placement['radial_angle_deg']);n=App.Vector(math.cos(a),math.sin(a),0)
                b.Placement=App.Placement(App.Vector(0,0,placement['z_mm']),App.Rotation(App.Vector(-math.sin(a),math.cos(a),0),App.Vector(0,0,1),n,'ZXY'))
            elif placement and item.get('group')!='pinion':
                b.Placement=App.Placement(App.Vector(placement.get('x_mm',0),placement.get('y_mm',0),0),App.Rotation())
            result['final_volume_mm3']=b.Tip.Shape.Volume;log['parts'].append(result)
            (run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8')
        doc.recompute()
        if App.GuiUp:
            for g in groups.values():g.Visibility=True
            mapping={p['name']:p for p in PLAN['parts']}
            for b in [b for b in doc.Objects if b.TypeId=='PartDesign::Body']:apply_body_appearance(b,mapping[b.Label])
            import FreeCADGui as Gui
            view=Gui.getDocument(doc.Name).activeView();view.viewAxonometric();view.fitAll()
        path=run/'Zoom_v02.FCStd';doc.recompute();doc.saveAs(str(path))
        log.update(status='success',document=str(path));(run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8')
        print('Saved '+str(path),flush=True)
    except Exception:
        log.update(status='failed',error=traceback.format_exc());(run/'build_report.json').write_text(json.dumps(log,indent=2),'utf8');raise

zoom_main()
