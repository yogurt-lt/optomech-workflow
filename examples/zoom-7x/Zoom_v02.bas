Private Sub CamSolidCheck(ByVal model As SldWorks.ModelDoc2, ByVal cutName As String)
    Dim part As SldWorks.PartDoc, bodies As Variant, count As Long, status As Long
    Dim path As String
    Set part = model
    bodies = part.GetBodies2(0, False)
    If IsArray(bodies) Then count = UBound(bodies) - LBound(bodies) + 1
    buildLog.WriteLine "Cam solid bodies after " & cutName & ": " & CStr(count)
    If count <> 1 Then
        path = diagnosticFolder & "\50_Cam_DIAGNOSTIC.SLDPRT"
        status = model.SaveAs3(path, 0, SAVE_SILENT)
        currentStage = "Cam split after " & cutName
        Err.Raise vbObjectError + 814, , "Cam bodies=" & CStr(count) & " after " & cutName & "; diagnostic save status=" & CStr(status) & "; file=" & path
    End If
End Sub
