Private Function CleanProfilePoints(ByVal raw As Variant) As Variant
    Dim clean() As Variant, p As Variant, q As Variant
    Dim i As Long, count As Long, dz As Double, dr As Double
    ReDim clean(UBound(raw) - LBound(raw))
    For i = LBound(raw) To UBound(raw)
        p = raw(i)
        If count = 0 Then
            clean(count) = p: count = count + 1
        Else
            q = clean(count - 1)
            dz = CDbl(p(0)) - CDbl(q(0)): dr = CDbl(p(1)) - CDbl(q(1))
            If dz * dz + dr * dr > 0.000000000001 Then
                clean(count) = p: count = count + 1
            End If
        End If
    Next i
    If count > 1 Then
        p = clean(count - 1): q = clean(0)
        dz = CDbl(p(0)) - CDbl(q(0)): dr = CDbl(p(1)) - CDbl(q(1))
        If dz * dz + dr * dr <= 0.000000000001 Then count = count - 1
    End If
    If count < 3 Then Err.Raise vbObjectError + 815, , "Degenerate profile after duplicate-point cleanup."
    ReDim Preserve clean(count - 1)
    If Not buildLog Is Nothing Then buildLog.WriteLine "Profile cleanup: " & CStr(UBound(raw) - LBound(raw) + 1) & " -> " & CStr(count)
    CleanProfilePoints = clean
End Function
